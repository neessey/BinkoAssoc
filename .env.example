# ── Firebase côté navigateur (public, sans danger : la sécurité est assurée par les règles) ──
# Console Firebase > Paramètres du projet > Vos applications > Application Web
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=votre-projet.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=votre-projet
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Firebase Admin (SECRET — jamais dans le code, jamais préfixé NEXT_PUBLIC_) ──
# Console Firebase > Paramètres du projet > Comptes de service > Générer une nouvelle clé privée
FIREBASE_PROJECT_ID=votre-projet
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@votre-projet.iam.gserviceaccount.com
# Coller la clé sur une seule ligne, avec les \n, entre guillemets
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ── Cloudinary (photos des biens) ──
# cloudinary.com > Dashboard (ou Settings > API Keys)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
# SECRET : uniquement côté serveur
CLOUDINARY_API_SECRET=

# Chaîne aléatoire longue (ex : openssl rand -hex 32) pour anonymiser les IP du rate limiting
RATE_LIMIT_SALT=
